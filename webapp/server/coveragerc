# apps/ only; migrations and settings would inflate the figure.

[run]
source = apps
branch = True
omit =
    */migrations/*
    */tests/*
    */__init__.py
    */apps.py
    */admin.py

[report]
show_missing = True
skip_covered = True
precision = 1
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError
    if __name__ == .__main__.:

[xml]
output = test-reports/coverage.xml
