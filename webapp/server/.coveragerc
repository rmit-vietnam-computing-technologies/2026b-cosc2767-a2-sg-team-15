# Acknowledgement: Drafted with Claude (Anthropic) in a guided session; the
#   author reviewed and verified the resulting report. Reference:
#   coverage.py configuration reference, https://coverage.readthedocs.io/en/latest/config.html

# Measure apps/ only; migrations and settings would
# inflate the figure without meaning anything.

[run]
source = apps
branch = True
omit =
    */migrations/*
    */tests/*
    */__init__.py
    */apps.py
    */admin.py

[report]
show_missing = True
skip_covered = True
precision = 1
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError
    if __name__ == .__main__.:

[xml]
output = test-reports/coverage.xml
