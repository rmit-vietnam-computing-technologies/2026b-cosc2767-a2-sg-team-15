// Last modified: 14/09/2026
// Acknowledgement: API stages drafted with Claude (Anthropic); every script
//   they call was run by hand first (see deploy/README.md). Reference: Jenkins
//   declarative pipeline syntax, https://www.jenkins.io/doc/book/pipeline/syntax/

// One push runs: API tests, frontend image, API image, staging, prod.
// Prod only on main and only after staging smoke passed. Any red stage
// stops the run and mails the team.
//
// Credentials, by ID: aws-access-key-id, aws-secret-access-key,
// aws-session-token (strings). The deploy stages write their own kubeconfig
// with aws eks update-kubeconfig; kubectl signs in with those keys.
// Agent needs docker, aws and kubectl.

pipeline {
    agent any

    environment {
        // Docker image info
        DOCKER_IMAGE_NAME = 'rmit-store-frontend'
        DOCKER_TAG = "v2"

        //ECR information
        AWS_ACCOUNT_ID = '909892551050'
        AWS_REGION = 'us-east-1'
        ECR_REPO_NAME = 'rmit-store-frontend'
        ECR_URI = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO_NAME}"

        // Backend
        ECR_API_REPO = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/rmit-store-api"
    }

    stages {
        // Ensure docker is running
        stage('Ensure docker is running') {
            steps {
               sh '''
                if ! docker ps > /dev/null; then
                    echo "Docker has not started"
                    sudo service docker start
                    sleep 10
                    docker ps &> /dev/null || (echo "Docker failed to start" && exit 1)
                else
                    echo "Docker is already running."
                fi
               '''

            }
        }

        // Nothing gets built or pushed if the suite is red.
        stage('API: test') {
            steps {
                script {
                    env.TAG = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                }
                sh 'export HOST_UID=$(id -u) HOST_GID=$(id -g) && deploy/bin/test.sh $TAG'
            }
            post {
                always {
                    junit 'webapp/server/test-reports/junit.xml'
                }
            }
        }

        //
        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image...'
                dir('webapp/client') {
                    sh 'docker build -t ${DOCKER_IMAGE_NAME}:${DOCKER_TAG} .'
                }
                echo 'Docker image built'
            }
        }

        // stage('Testing purchasing and correct credit card validation') {
        //     steps {
        //         echo 'Temporary test(Also placeholder for now)'
        //         dir('webapp/client/tests') {
        //         sh 'pytest rmit-store-order.py'
        //     }
        //         echo 'Checking out test passed'
        //     }
        // }

        // Pushing to ECR
        stage('Push to ECR') {
            steps {
                script {
                    withCredentials([
                string(credentialsId: 'aws-access-key-id', variable: 'AWS_ACCESS_KEY_ID'),
                string(credentialsId: 'aws-secret-access-key', variable: 'AWS_SECRET_ACCESS_KEY'),
                string(credentialsId: 'aws-session-token', variable: 'AWS_SESSION_TOKEN')
            ]) {
                        sh '''
                            aws ecr get-login-password --region ${AWS_REGION} | \
                                docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

                            docker tag ${DOCKER_IMAGE_NAME}:${DOCKER_TAG} ${ECR_URI}:latest
                            docker push ${ECR_URI}:latest
                        '''
                    }
                }
            echo "Pushed image to ECR correctly"
            }
        }

        stage('API: build and push') {
            steps {
                withCredentials([
                    string(credentialsId: 'aws-access-key-id',     variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'aws-secret-access-key', variable: 'AWS_SECRET_ACCESS_KEY'),
                    string(credentialsId: 'aws-session-token',     variable: 'AWS_SESSION_TOKEN')
                ]) {
                    sh 'ECR_REPO=$ECR_API_REPO deploy/bin/build-push.sh $TAG'
                }
            }
        }

        stage('API: deploy staging') {
            environment { KUBECONFIG = "${WORKSPACE}/eks.kubeconfig" }
            steps {
                withCredentials([
                    string(credentialsId: 'aws-access-key-id',     variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'aws-secret-access-key', variable: 'AWS_SECRET_ACCESS_KEY'),
                    string(credentialsId: 'aws-session-token',     variable: 'AWS_SESSION_TOKEN')
                ]) {
                    // The kubeconfig holds no secret; kubectl signs in with the keys above.
                    sh 'aws eks update-kubeconfig --name rmit-store-eks --region $AWS_REGION --kubeconfig $KUBECONFIG'
                    sh 'ECR_REPO=$ECR_API_REPO deploy/bin/deploy.sh staging $TAG'
                    sh 'deploy/bin/smoke.sh staging $TAG'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'webapp/server/test-reports/smoke-staging.xml'
                }
            }
        }

        // Same image staging just passed with, promoted. main only.
        stage('API: deploy prod') {
            when {
                anyOf { branch 'main'; expression { env.GIT_BRANCH == 'origin/main' } }
            }
            environment { KUBECONFIG = "${WORKSPACE}/eks.kubeconfig" }
            steps {
                withCredentials([
                    string(credentialsId: 'aws-access-key-id',     variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'aws-secret-access-key', variable: 'AWS_SECRET_ACCESS_KEY'),
                    string(credentialsId: 'aws-session-token',     variable: 'AWS_SESSION_TOKEN')
                ]) {
                    // The kubeconfig holds no secret; kubectl signs in with the keys above.
                    sh 'aws eks update-kubeconfig --name rmit-store-eks --region $AWS_REGION --kubeconfig $KUBECONFIG'
                    sh 'ECR_REPO=$ECR_API_REPO deploy/bin/deploy.sh prod $TAG'
                    sh 'deploy/bin/smoke.sh prod $TAG'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'webapp/server/test-reports/smoke-prod.xml'
                }
            }
        }
    }
    post {
        success {
            echo 'Pipeline suceeded'
        }
        failure {
            echo 'Pipeline failed'
            // Needs Jenkins > System > E-mail Notification configured with an SMTP server.
            mail to: 'REPLACE_WITH_TEAM_EMAIL',
                 subject: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER} (${env.TAG})",
                 body: "A stage went red, prod was not touched. Console: ${env.BUILD_URL}console"
        }
    }
}
