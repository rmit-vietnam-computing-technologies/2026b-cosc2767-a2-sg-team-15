pipeline {
    agent any

    environment {
        // Docker image info
        DOCKER_IMAGE_NAME = 'rmit-store-frontend'
        DOCKER_TAG = "v2"
        
        //ECR information
        AWS_ACCOUNT_ID = '909892551050'          
        AWS_REGION = 'us-east-1'
        ECR_REPO_NAME = 'rmit-store-frontend'    
        ECR_URI = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO_NAME}"
    }

    stages {
        // Placeholder test
        stage('Test Frontend') {
            steps {
                echo 'Placeholder testing (to be added later)'
                dir('webapp/client') {
                    // sh 'npm run test:unit'
                }
                echo 'Tests passed'
            }
        }

        // 
        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image...'
                dir('webapp/client') {
                    sh 'docker build -t ${DOCKER_IMAGE_NAME}:${DOCKER_TAG} .'
                }
                echo 'Docker image built'
            }
        }

        // Pushing to ECR
        stage('Push to ECR') {
            steps {
                echo 'Pushing image to ECR...'
                script {
                    sh '''
                        
                        aws ecr get-login-password --region ${AWS_REGION} | \
                            docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                        
                        
                        docker tag ${DOCKER_IMAGE_NAME}:${DOCKER_TAG} ${ECR_URI}:${DOCKER_TAG}
                        
                        
                        docker push ${ECR_URI}:${DOCKER_TAG}
                    '''
                }
                echo 'Image pushed to ECR successfully'
            }
        }
    }

    post {
        success {
            echo 'Pipeline suceeded'
        }
        failure {
            echo 'Pipeline failed'
        }
    }
}