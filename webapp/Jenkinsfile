pipeline {
    agent any

    environment {
        // ============================================
        // 📌 CẤU HÌNH DOCKER HUB
        // ============================================
        DOCKER_HUB_USERNAME = 'ztz99a2'
        DOCKER_IMAGE_NAME = 'rmit-store-frontend'
        DOCKER_TAG = "${env.BUILD_ID}"
        
        DEPLOY_EC2_IP = '98.90.194.9'
        DEPLOY_EC2_USER = 'ec2-user'
    }

    stages {
        // --- STAGE 1: BUILD FRONTEND ---
        stage('Build Frontend') {
            steps {
                echo '📦 Building Vue application...'
                dir('client') {
                    sh 'npm install'
                    sh 'npm run build'
                }
                echo '✅ Build completed!'
            }
        }

        // --- STAGE 2: TEST FRONTEND (Tùy chọn) ---
        stage('Test Frontend') {
            steps {
                echo '🧪 Running frontend tests...'
                dir('client') {
                    // sh 'npm run test:unit'
                }
                echo '✅ Tests passed!'
            }
        }

        // --- STAGE 3: BUILD DOCKER IMAGE (Dùng sudo) ---
        stage('Build Docker Image') {
            steps {
                echo '🐳 Building Docker image...'
                script {
                    // Build image với tên Docker Hub + tên image + tag
                    sh """
                        sudo docker build -t ${DOCKER_HUB_USERNAME}/${DOCKER_IMAGE_NAME}:${DOCKER_TAG} client/
                    """
                }
                echo '✅ Docker image built!'
            }
        }

        // --- STAGE 4: PUSH DOCKER IMAGE LÊN DOCKER HUB (Dùng sudo) ---
        stage('Push Docker Image to Docker Hub') {
            steps {
                echo '☁️ Pushing image to Docker Hub...'
                script {
                    // Đăng nhập Docker Hub và push image
                    sh """
                        echo ${DOCKER_HUB_PASSWORD} | sudo docker login -u ${DOCKER_HUB_USERNAME} --password-stdin
                        sudo docker push ${DOCKER_HUB_USERNAME}/${DOCKER_IMAGE_NAME}:${DOCKER_TAG}
                    """
                }
                echo '✅ Image pushed successfully!'
            }
        }

        // --- STAGE 5: DEPLOY FRONTEND LÊN EC2 (Tất cả lệnh đều có sudo) ---
        stage('Deploy Frontend to EC2') {
            steps {
                echo '🚀 Deploying frontend to EC2...'
                script {
                    sh """
                        ssh -o StrictHostKeyChecking=no -i ~/.ssh/devops_project_key.pem ${DEPLOY_EC2_USER}@${DEPLOY_EC2_IP} "
                            # Kéo image mới nhất từ Docker Hub
                            sudo docker pull ${DOCKER_HUB_USERNAME}/${DOCKER_IMAGE_NAME}:${DOCKER_TAG}
                            
                            # Dừng và xóa container cũ (nếu có)
                            sudo docker stop frontend-container || true
                            sudo docker rm frontend-container || true
                            
                            # Chạy container mới từ image vừa kéo, ánh xạ cổng 80 (HTTP) ra ngoài
                            sudo docker run -d --name frontend-container -p 80:80 ${DOCKER_HUB_USERNAME}/${DOCKER_IMAGE_NAME}:${DOCKER_TAG}
                        "
                    """
                }
                echo '✅ Deployment completed!'
            }
        }
    }

    // --- POST-BUILD ACTIONS ---
    post {
        success {
            echo '🎉 Pipeline succeeded!'
        }
        failure {
            echo '❌ Pipeline failed!'
        }
    }
}