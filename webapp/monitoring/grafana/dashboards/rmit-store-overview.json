{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "METRIC: Backend availability. Prometheus uses the 'up' metric to determine whether it can successfully scrape the RMIT Store Django backend. Value 1 = backend is reachable and being scraped successfully. Value 0 = Prometheus cannot scrape the backend.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "expr": "up{job=\"rmit-store-django\"}",
          "legendFormat": "Backend",
          "refId": "A"
        }
      ],
      "title": "Backend Availability",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "METRIC: HTTP request rate. Measures the number of HTTP requests received by Django per second, calculated using a 5-minute rate window. This shows the current traffic/load on the backend.",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "mappings": [],
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "expr": "rate(django_http_requests_before_middlewares_total[5m])",
          "legendFormat": "Requests/sec",
          "refId": "A"
        }
      ],
      "title": "HTTP Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "METRIC: HTTP 5xx error percentage. Calculates the percentage of HTTP responses that returned a 5xx server error during the previous 5 minutes. Formula: 5xx responses divided by total responses multiplied by 100. Alert threshold: above 5% for 5 minutes.",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "mappings": [],
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "expr": "100 * (sum(rate(django_http_responses_total_by_status_total{status=~\"5..\"}[5m])) or vector(0)) / sum(rate(django_http_responses_total_by_status_total[5m]))",
          "legendFormat": "5xx %",
          "refId": "A"
        }
      ],
      "title": "HTTP 5xx Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "METRIC: HTTP p95 latency. Measures the 95th-percentile HTTP request latency using Django's request latency histogram. Approximately 95% of requests should complete within this value. Alert threshold: above 1 second for 5 minutes.",
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "mappings": [],
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(django_http_requests_latency_seconds_by_view_method_bucket[5m])))",
          "legendFormat": "p95 latency",
          "refId": "A"
        }
      ],
      "title": "HTTP p95 Latency",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "METRIC: Number of currently active Prometheus alerts for the RMIT Store backend. Value 0 = no active alerts. Value 1 or greater = one or more alerts are currently active.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "expr": "sum(ALERTS{job=\"rmit-store-django\"}) or vector(0)",
          "legendFormat": "Active alerts",
          "refId": "A"
        }
      ],
      "title": "Active Alerts",
      "type": "stat"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": [
    "rmit-store",
    "monitoring",
    "prometheus"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "RMIT Store Monitoring",
  "uid": "rmit-store-monitoring",
  "version": 1,
  "weekStart": ""
}