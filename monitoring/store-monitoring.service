[Unit]
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target
Description=RMIT store monitoring

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/rmit-store/monitoring
ExecStart=/usr/bin/docker-compose up -d
ExecStop=/usr/bin/docker-compoes down -d
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
