# =========================================================
# COSC2767 .gitignore — safe submission version
# =========================================================

# ---------------------------------------------------------
# OS generated files
# ---------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------
# Editor / IDE files
# ---------------------------------------------------------
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.project
.classpath
.settings/

# ---------------------------------------------------------------------------
# Secrets and local configuration
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.eggs/
dist/
build/

# Test and coverage output
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# --- Django ----------------------------------------------------------------
*.log
db.sqlite3
db.sqlite3-journal

# collectstatic output — generated at deploy time, never committed
webapp/server/staticfiles/*
!webapp/server/staticfiles/.gitkeep

# Uploaded product images. In production these belong in S3, not on the
# instance's disk (see USE_S3 in webapp/server/.env.example).
webapp/server/media/
webapp/server/.venv/

# --- Node ------------------------------------------------------------------
node_modules/
webapp/client/dist/
webapp/client/node_modules/
.npm
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Test and coverage output
#
# Generated per build and published by Jenkins from the workspace. A committed
# report is a stale number outliving the code it measured.
# ---------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
test-reports/
test-results/
playwright-report/


# ---------------------------------------------------------
# Environment files and credentials
# ---------------------------------------------------------
# Encrypted secret files may be committed only after encryption.
!*.sops.yaml
!*.sops.yml
!*.enc

# Private keys and certificates — always keep out of Git.
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
*.ppk

# Local SSH/AWS/Kubernetes credentials — always keep out of Git.
.ssh/
.aws/
.kube/
kubeconfig
*.kubeconfig

# ---------------------------------------------------------
# Ansible private files
# ---------------------------------------------------------
.vault_pass
vault_pass.txt
*.vault

# ---------------------------------------------------------
# Local caches and temporary files
# ---------------------------------------------------------
.cache/
.tmp/
*.tmp
*.bak
*.backup

# Allow the specific rollback copies used by Question 7.
!**/index.jsp.tmp
!**/index.jsp.bak
!**/index.jsp.backup

# ---------------------------------------------------------
# Language/tool caches
# ---------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/
node_modules/
.m2/
.gradle/

# ---------------------------------------------------------
# Local tool state
# ---------------------------------------------------------
.docker/
.terraform/
*.tfstate
*.tfstate.*
crash.log

# ---------------------------------------------------------
# Empty directories required by the exam
# ---------------------------------------------------------
# Git does not track empty directories. Add .gitkeep to any
# required empty directory, e.g. my_project/bin/.gitkeep.
!**/.gitkeep

# ---------------------------------------------------------
# Jenkins local state
# ---------------------------------------------------------
# Jenkins home can contain credentials, plugins, workspaces,
# build history, and machine-specific state. Keep it ignored.
# Permit only job configuration files intentionally submitted.
.jenkins/*
!.jenkins/jobs/
.jenkins/jobs/**
!.jenkins/jobs/**/
!.jenkins/jobs/**/config.xml

jenkins_home/*
!jenkins_home/jobs/
jenkins_home/jobs/**
!jenkins_home/jobs/**/
!jenkins_home/jobs/**/config.xml

# tfplan
**/*.tfplan
# ---------------------------------------------------------------------------
# Editors, OS and local caches not covered upstream
# ---------------------------------------------------------------------------
desktop.ini
*.iml
.project
.classpath
.settings/
*.swo
.cache/
.tmp/
*.tmp
*.bak
*.backup
.docker/

# Git does not track empty directories; keep the markers we add
!**/.gitkeep
