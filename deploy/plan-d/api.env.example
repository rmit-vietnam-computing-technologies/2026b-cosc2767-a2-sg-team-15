#   values follow deploy/plan-c/roles/api/templates/api.env.j2.

# The API container on the Plan D API instance --
# TEMPLATE, placeholders only.
#
#     cp api.env.example api.env && nano api.env
#     docker run ... --env-file api.env <image>
#
# docker --env-file passes values VERBATIM: do not quote them, or the quotes
# become part of the value. No spaces around `=`.
#
# Nothing here is a credential for AWS. The container gets bucket access
# from the instance profile (LabInstanceProfile -> LabRole) through the
# instance metadata service; see the hop-limit note in the runbook.

# --- Django --------------------------------------------------------------
# DJANGO_SETTINGS_MODULE is baked into the image as config.settings.prod.

SECRET_KEY=REPLACE_WITH_GENERATED_SECRET

# Everything a request may carry as Host: the web host's
# public address (forwarded by nginx unchanged), this instance's private
# address (the web tier's upstream, and any direct probe), and loopback for
# the image's own health check.
ALLOWED_HOSTS=REPLACE_WITH_WEB_ELASTIC_IP,REPLACE_WITH_API_PRIVATE_IP,127.0.0.1,localhost

# The store as the browser sees it.
CLIENT_URL=http://REPLACE_WITH_WEB_ELASTIC_IP
CORS_ALLOWED_ORIGINS=http://REPLACE_WITH_WEB_ELASTIC_IP
CSRF_TRUSTED_ORIGINS=http://REPLACE_WITH_WEB_ELASTIC_IP

# Plain http until TLS terminates in front of the web tier.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

WEB_CONCURRENCY=3

# --- Database ------------------------------------------------------------
# `db` is the postgres container on this host, on the same user-defined
# Docker network; nothing publishes 5432. RDS replaces it in Plan F.
DATABASE_URL=postgres://rmit:REPLACE_WITH_DATABASE_PASSWORD@db:5432/rmit_store

# --- Media: S3, because there are two hosts --------------------------------
# Two instances have no shared disk, so uploads leave
# the instance. docs/adr/0003-media-storage.md.
USE_S3=True
AWS_STORAGE_BUCKET_NAME=REPLACE_WITH_BUCKET_NAME
AWS_S3_REGION_NAME=us-east-1
# False: plain public URLs, needs the bucket policy that allows GetObject
# on media/*. True: presigned URLs, needs no policy -- the fallback if the
# account refuses public buckets.
AWS_S3_QUERYSTRING_AUTH=False
