# Acknowledgement: The variable is consumed by deploy/nginx/web.conf.template.

# The web container on the Plan D web instance --
# TEMPLATE, placeholder only.
#
# The one thing this tier needs to know: where the API is. An IP literal,
# so nginx's resolver is idle and no DNS is involved. The API instance's
# security group must allow 8000 from the web instance's group.
#
# Run the web image with deploy/nginx/web.conf.template mounted at
# /etc/nginx/templates/default.conf.template, as compose.yaml does, or the
# variable has nothing to substitute into.

API_UPSTREAM=REPLACE_WITH_API_PRIVATE_IP:8000
