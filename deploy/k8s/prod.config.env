# Acknowledgement: Variables from webapp/server/config/settings/base.py and prod.py.

# Non-secret settings for prod, loaded into the api-config ConfigMap by deploy.sh.
# Public values only; anything secret lives in prod.secret.env (gitignored).

# Node Elastic IP and private IP, plus loopback for the image's own health check.
ALLOWED_HOSTS=54.144.69.199,172.31.81.134,localhost,127.0.0.1

# Where the SPA lives as the browser sees it. Update when the web tier is in front.
CLIENT_URL=http://54.144.69.199:80
CORS_ALLOWED_ORIGINS=http://54.144.69.199:80
CSRF_TRUSTED_ORIGINS=http://54.144.69.199:80

# Plain http until TLS terminates in front.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Media on the prod bucket; credentials come from the node's instance profile.
USE_S3=True
AWS_STORAGE_BUCKET_NAME=rmit-store-media-prod-t15-260913
AWS_S3_REGION_NAME=us-east-1
AWS_S3_QUERYSTRING_AUTH=False

# One gunicorn worker per pod; scale with replicas.
WEB_CONCURRENCY=1

# Read by deploy/bin/smoke.sh, ignored by the app.
SMOKE_BASE_URL=http://54.144.69.199:80
