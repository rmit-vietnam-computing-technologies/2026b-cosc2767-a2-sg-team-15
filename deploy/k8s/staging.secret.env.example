# TEMPLATE, placeholders only. Normally not needed: deploy.sh reads these
# same keys from SSM Parameter Store under /rmit-store/staging/, written by
# terraform/backend. To bypass SSM:  cp staging.secret.env.example staging.secret.env
# and run with SECRET_FILE=deploy/k8s/staging.secret.env.

# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET

# terraform output -raw database_url_staging   (in terraform/backend)
DATABASE_URL=postgres://rmit:REPLACE_WITH_DATABASE_PASSWORD@REPLACE_WITH_RDS_ENDPOINT:5432/rmit_staging

# Used by the seed job and by the smoke suite's declined-card check.
SEED_ADMIN_EMAIL=admin@rmit.edu.au
