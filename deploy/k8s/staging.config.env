# Acknowledgement: Variables from webapp/server/config/settings/base.py and prod.py.

# Non-secret settings for staging, loaded into the api-config ConfigMap by deploy.sh.
# Public values only; anything secret lives in staging.secret.env (gitignored).

# k3s node Elastic IP and private IP, any EKS classic ELB in the region, and
# loopback for the image's own health check.
ALLOWED_HOSTS=54.144.69.199,172.31.81.134,.us-east-1.elb.amazonaws.com,localhost,127.0.0.1

# Where the SPA lives as the browser sees it. Update when the web tier is in front.
CLIENT_URL=http://54.144.69.199:8080
CORS_ALLOWED_ORIGINS=http://54.144.69.199:8080
CSRF_TRUSTED_ORIGINS=http://54.144.69.199:8080,http://*.us-east-1.elb.amazonaws.com

# Plain http until TLS terminates in front.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Media on the staging bucket; credentials come from the node role via IMDS.
USE_S3=True
AWS_STORAGE_BUCKET_NAME=rmit-store-media-staging-t15-260913
AWS_S3_REGION_NAME=us-east-1
AWS_S3_QUERYSTRING_AUTH=False

# One gunicorn worker per pod; scale with replicas.
WEB_CONCURRENCY=1

# Read by deploy/bin when the Service has no hostname of its own (k3s); ignored by the app.
SMOKE_BASE_URL=http://54.144.69.199:8080
