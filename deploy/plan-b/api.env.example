#   UPSTREAM-README.md, reorganised for delivery through a systemd
#   EnvironmentFile rather than a .env inside the checkout.

# Plan B API environment — TEMPLATE, placeholders only.
#
# Copy to the instance, fill in, and lock down:
#
#   sudo mkdir -p /etc/rmit-store
#   sudo cp api.env.example /etc/rmit-store/api.env
#   sudo nano /etc/rmit-store/api.env
#   sudo chown root:root /etc/rmit-store/api.env
#   sudo chmod 600       /etc/rmit-store/api.env
#
# Read by rmit-api.service via EnvironmentFile=. Never commit the filled-in
# copy; this template exists so a marker can see every variable the
# deployment needs without any of the values.
#
# systemd parses this file itself, not through a shell. Do not quote values
# and do not use $VARIABLE expansion — both end up literal.
#
# Running manage.py by hand needs the same variables. Load them with:
#
#   set -a; source /etc/rmit-store/api.env; set +a
#
# Forgetting is loud, not silent: config.settings.prod refuses to start
# without a real SECRET_KEY, which is the guard working as intended.

# --- Django ----------------------------------------------------------------

# DJANGO_SETTINGS_MODULE is deliberately NOT here. config/wsgi.py reads it
# before this file has been parsed, so it is set in the systemd unit instead.

# Generate a real one, never reuse the shipped default:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-generated-key

# Every hostname the instance is reached by. The public IP must be here or
# Django answers 400 to every request before it reaches a view — including
# the health check, which is how a healthy instance gets marked unhealthy.
#
# In a Learner Lab this changes every time the instance restarts, unless an
# Elastic IP is attached. Allocating one is worth the two minutes.
ALLOWED_HOSTS=REPLACE_WITH_PUBLIC_IP,127.0.0.1,localhost

# --- Database --------------------------------------------------------------

# localhost, not the public IP, while the database is on this instance.
# Routing a connection out to the internet and back is slower and usually
# blocked outright.
DATABASE_URL=postgres://rmit:replace-me@localhost:5432/rmit_store

# --- URLs the application generates ----------------------------------------

# Builds the links in outgoing email. Point it at the origin a human will
# click, not at a dev server.
CLIENT_URL=http://REPLACE_WITH_PUBLIC_IP

# One origin behind nginx, so these are the same value. They stop being the
# same the moment the tiers are split.
CORS_ALLOWED_ORIGINS=http://REPLACE_WITH_PUBLIC_IP
CSRF_TRUSTED_ORIGINS=http://REPLACE_WITH_PUBLIC_IP

# --- Plain HTTP, for now ---------------------------------------------------

# prod.py defaults both to True, and a secure cookie is never sent over
# http://. Left on, the admin login accepts the password and bounces straight
# back to the login form with no error — which looks like a wrong password
# and is not.
#
# Turn both back on the day TLS terminates in front of this. Recorded in
# Known Problems until then.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# --- Build identity --------------------------------------------------------

# Reported by GET /api/version/, which is how a deploy is verified
# from outside the instance and how a blue/green cutover is confirmed.
# Set GIT_COMMIT from the deploy itself: $(git rev-parse --short HEAD)
APP_VERSION=1.0.0
GIT_COMMIT=REPLACE_WITH_DEPLOYED_SHA
