# Acknowledgement: Values derived from webapp/server/.env.example and step 9.2 of
#   UPSTREAM-README.md, reorganised for delivery through a systemd
#   EnvironmentFile rather than a .env inside the checkout.

# Plan B API environment -- TEMPLATE, placeholders only.
#
#   sudo install -m 600 -o root -g root api.env.example /etc/rmit-store/api.env
#
# Read by rmit-api.service via EnvironmentFile=. systemd parses it literally:
# no quotes, no $VARIABLE expansion. For manage.py by hand:
#   set -a; source /etc/rmit-store/api.env; set +a

# --- Django ----------------------------------------------------------------

# DJANGO_SETTINGS_MODULE is set in the systemd unit, which is parsed first.

#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-generated-key

# Every hostname the instance is reached by, or Django answers 400 (health
# checks included). Attach an Elastic IP so this stops changing.
ALLOWED_HOSTS=REPLACE_WITH_PUBLIC_IP,127.0.0.1,localhost

# --- Database --------------------------------------------------------------

# localhost while the database is on this instance.
DATABASE_URL=postgres://rmit:replace-me@localhost:5432/rmit_store

# --- URLs the application generates ----------------------------------------

# Builds the links in outgoing email.
CLIENT_URL=http://REPLACE_WITH_PUBLIC_IP

# One origin behind nginx, so the same value.
CORS_ALLOWED_ORIGINS=http://REPLACE_WITH_PUBLIC_IP
CSRF_TRUSTED_ORIGINS=http://REPLACE_WITH_PUBLIC_IP

# --- Plain HTTP, for now ---------------------------------------------------

# prod.py defaults both to True; over plain http the admin login loops.
# Turn back on once TLS terminates in front. Recorded under Known Problems.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# --- Build identity --------------------------------------------------------

# Reported by GET /api/version/. GIT_COMMIT=$(git rev-parse --short HEAD)
APP_VERSION=1.0.0
GIT_COMMIT=REPLACE_WITH_DEPLOYED_SHA
