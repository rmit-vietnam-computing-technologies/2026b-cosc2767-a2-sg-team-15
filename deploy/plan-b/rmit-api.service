# Acknowledgement: Adapted from step 9.3 of UPSTREAM-README.md. Changed from
#   the original: paths point at this repository's layout rather than a bare
#   upstream clone, secrets are loaded from an EnvironmentFile owned by root
#   instead of a world-readable .env inside a traversable home directory, and
#   two sandboxing directives are set. References:
#   systemd.exec, https://www.freedesktop.org/software/systemd/man/systemd.exec.html
#   gunicorn deployment, https://docs.gunicorn.org/en/stable/deploy.html

# The API as a managed service: survives logout,
# restarts on crash, starts on boot, logs to the journal.
# Install to /etc/systemd/system/, then systemctl daemon-reload && enable --now rmit-api.

[Unit]
Description=RMIT Store API (gunicorn)
Documentation=https://github.com/rmit-2026b-cosc2767/2026b-cosc2767-a2-sg-team-15
After=network.target postgresql.service
Wants=postgresql.service

[Service]
# ec2-user, not root: nginx must traverse this user's home to serve media.
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/2026b-cosc2767-a2-sg-team-15/webapp/server

# Root-owned, mode 600, outside the (traversable) checkout.
EnvironmentFile=/etc/rmit-store/api.env

# Here rather than in the env file: config/wsgi.py reads it before django-environ loads.
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod

# --bind 127.0.0.1: only nginx should reach gunicorn.
ExecStart=/home/ec2-user/2026b-cosc2767-a2-sg-team-15/webapp/server/.venv/bin/gunicorn \
    config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile - \
    --capture-output

# journalctl -u rmit-api -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rmit-api

Restart=always
RestartSec=3

# Cheap hardening.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
