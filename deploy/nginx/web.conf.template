# Acknowledgement: The web tier's site from
#   deploy/plan-c/roles/web/templates/web-nginx.conf.j2, re-targeted at a
#   container. Drafted with Claude (Anthropic) in a guided session; the
#   author ran and verified it. References: nginx proxy module,
#   https://nginx.org/en/docs/http/ngx_http_proxy_module.html; nginx
#   resolver directive,
#   https://nginx.org/en/docs/http/ngx_http_core_module.html#resolver;
#   the nginx image's template rendering, https://hub.docker.com/_/nginx
#   ("Using environment variables in nginx configuration").

# The web tier's site. Mounted at
# /etc/nginx/templates/default.conf.template; the nginx image's entrypoint
# substitutes ${API_UPSTREAM} and writes /etc/nginx/conf.d/default.conf at
# start. Every other $variable is nginx's own. Lives here rather than in
# webapp/client because the image is the frontend workstream's.

server {
    # IPv4 only: an [::]:80 listener fails to start where IPv6 is disabled.
    listen      80 default_server;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    client_max_body_size 10M;

    gzip            on;
    gzip_types      text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Resolve the API at request time, not at start: a container's address
    # changes when it is recreated. 127.0.0.11 is Docker's embedded DNS.
    resolver 127.0.0.11 ipv6=off valid=30s;
    set $rmit_api http://${API_UPSTREAM};

    # --- The SPA: an unknown path is a Vue route, not a missing file --------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Never cache runtime configuration.
    location = /config.js {
        add_header Cache-Control "no-store";
    }

    # Hashed filenames are immutable.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Uploads from the volume shared with the API. Idle once
    # USE_S3 is on.
    location /media/ {
        alias /srv/media/;
        access_log off;
        expires 7d;
    }

    # --- Everything the API tier owns ---------------------------------------
    location ~ ^/(api|admin|healthz|readyz|static)(/|$) {
        proxy_pass $rmit_api;

        # Forward the browser's Host unchanged: Django builds
        # image_url from it, and it must be in ALLOWED_HOSTS.
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_redirect off;

        # Fail fast: a 502 in five seconds beats a browser spinning.
        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
    }
}
