# Last modified: 09/09/2026
# Acknowledgement: Values derived from deploy/plan-b/api.env.example and the
#   manual steps in docs/runbooks/plan-b-ec2.md. Reference: Ansible variable
#   precedence, https://docs.ansible.com/ansible/latest/playbook_guide/playbooks_variables.html

---
# Deployment variables -- TEMPLATE, placeholders only.
#   cp group_vars/all.yml.example group_vars/all.yml
#
# Two addresses are supplied by hand because this playbook does not
# provision infrastructure; IaC removes both. Everything else is derived.
# Prerequisites (security groups, keys, ProxyJump) are in inventory.ini.example.

# --- Addresses -------------------------------------------------------------

# The web instance's Elastic IP; forwarded as Host, so also in ALLOWED_HOSTS.
web_public_ip: REPLACE_WITH_WEB_ELASTIC_IP

# The API instance's private address; the web host renders its nginx
# upstream from it. Same value as the [api] entry in inventory.ini.
api_private_ip: REPLACE_WITH_API_PRIVATE_IP

# --- Source ----------------------------------------------------------------

repo_url: git@github.com:rmit-vietnam-computing-technologies/2026b-cosc2767-a2-sg-team-15.git

# The ref both tiers clone from GitHub. Unpushed commits do not exist.
repo_version: dev/backend

app_user: ec2-user
app_root: /home/ec2-user/2026b-cosc2767-a2-sg-team-15

# rmit-api.service references this path.
venv_bin: /home/ec2-user/2026b-cosc2767-a2-sg-team-15/webapp/server/.venv/bin

# --- Django ----------------------------------------------------------------

# Generate once and keep it (url-safe: systemd reads the env file literally):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
django_secret_key: REPLACE_WITH_GENERATED_SECRET

app_version: "1.0.0"

# True only once TLS terminates in front of the web tier.
cookie_secure: false

# gunicorn workers; (2 x vCPU) + 1.
gunicorn_workers: 3

# --- Database --------------------------------------------------------------

# "localhost" installs PostgreSQL on the API instance; an RDS endpoint skips that role.
db_host: localhost
db_port: 5432
db_name: rmit_store
db_user: rmit
db_password: REPLACE_WITH_DATABASE_PASSWORD

# --- Frontend --------------------------------------------------------------

# Relative: the web tier proxies /api/, so the browser sees one origin.
web_api_base_url: "/api"

# Not /usr/share/nginx/html, which belongs to the nginx package.
web_root: /var/www/rmit-store

# --- Demo data -------------------------------------------------------------

# Guarded by a marker file, so a re-run reports ok.
seed_demo_data: true
seed_admin_email: admin@rmit.edu.au
seed_admin_password: REPLACE_WITH_ADMIN_PASSWORD

# --- Instance sizing -------------------------------------------------------

# The frontend build is OOM-killed on a 1 GB instance without this.
swap_mb: 2048

# --- Assembled for the manage.py tasks -------------------------------------

# The same variables systemd gives the service, so manage.py sees what gunicorn sees.
django_environment:
  DJANGO_SETTINGS_MODULE: config.settings.prod
  SECRET_KEY: "{{ django_secret_key }}"
  ALLOWED_HOSTS: "{{ web_public_ip }},{{ api_private_ip }},127.0.0.1,localhost"
  DATABASE_URL: "postgres://{{ db_user }}:{{ db_password }}@{{ db_host }}:{{ db_port }}/{{ db_name }}"
  CLIENT_URL: "http://{{ web_public_ip }}"
  CORS_ALLOWED_ORIGINS: "http://{{ web_public_ip }}"
  CSRF_TRUSTED_ORIGINS: "http://{{ web_public_ip }}"
  SESSION_COOKIE_SECURE: "{{ cookie_secure | ternary('True', 'False') }}"
  CSRF_COOKIE_SECURE: "{{ cookie_secure | ternary('True', 'False') }}"
  APP_VERSION: "{{ app_version }}"
  GIT_COMMIT: "{{ api_deployed_commit | default('unknown') }}"
