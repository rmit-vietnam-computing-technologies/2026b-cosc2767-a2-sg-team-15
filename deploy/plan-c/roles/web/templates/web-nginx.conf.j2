# MANAGED BY ANSIBLE -- edits here are overwritten on the next run.
# Source: deploy/plan-c/roles/web/templates/web-nginx.conf.j2

# The public entry point. Proxies the Django locations
# to the API instance; the browser still sees one origin, so the bundle
# carries no absolute API address and no cross-origin request is made.

upstream rmit_api {
    # The API instance's private address, from inventory.
    server {{ api_private_ip }}:80;
    keepalive 16;
}

server {
    listen      80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root  {{ web_root }};
    index index.html;

    client_max_body_size 10M;

    gzip            on;
    gzip_types      text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # --- The SPA: an unknown path is a Vue route, not a missing file --------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Never cache runtime configuration.
    location = /config.js {
        add_header Cache-Control "no-store";
    }

    # Hashed filenames are immutable.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # --- Everything the API tier owns, /media/ and /static/ included ---------
    location ~ ^/(api|admin|healthz|readyz|media|static)(/|$) {
        proxy_pass http://rmit_api;

        # Forward the browser's Host: Django builds image_url
        # from it, and it must be in the API's ALLOWED_HOSTS.
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_redirect off;

        # Fail fast: a 502 in five seconds beats a browser spinning.
        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
    }
}
