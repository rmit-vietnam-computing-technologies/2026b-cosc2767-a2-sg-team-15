# Source: deploy/plan-c/roles/api/templates/rmit-api.service.j2

[Unit]
Description=RMIT Store API (gunicorn)
After=network.target{% if db_host == "localhost" %} postgresql.service{% endif %}

{% if db_host == "localhost" %}
Wants=postgresql.service
{% endif %}

[Service]
User={{ app_user }}
Group={{ app_user }}
WorkingDirectory={{ app_root }}/webapp/server

# [T15-BE-SECRETS] Root-owned, mode 600, outside the checkout. systemd reads
# this as root before dropping to {{ app_user }}, so the application never
# needs permission to read its own secrets.
EnvironmentFile=/etc/rmit-store/api.env

# Set here, not in the environment file: config/wsgi.py reads it before
# django-environ has parsed anything, so a value in a file loaded later is
# too late and the failure is a confusing ImproperlyConfigured.
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod

# Bound to localhost. nginx on this instance is the only thing that reaches
# gunicorn; the security group is the second line of defence, not the first.
ExecStart={{ venv_bin }}/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers {{ gunicorn_workers }} \
    --timeout 60 \
    --access-logfile - \
    --error-logfile - \
    --capture-output

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rmit-api

Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
