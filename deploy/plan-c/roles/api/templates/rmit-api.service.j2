# Source: deploy/plan-c/roles/api/templates/rmit-api.service.j2

[Unit]
Description=RMIT Store API (gunicorn)
After=network.target{% if db_host == "localhost" %} postgresql.service{% endif %}

{% if db_host == "localhost" %}
Wants=postgresql.service
{% endif %}

[Service]
User={{ app_user }}
Group={{ app_user }}
WorkingDirectory={{ app_root }}/webapp/server

# Root-owned, mode 600, outside the checkout.
EnvironmentFile=/etc/rmit-store/api.env

# Here, not in the env file: config/wsgi.py reads it before django-environ loads.
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod

# Localhost: only nginx on this instance reaches gunicorn.
ExecStart={{ venv_bin }}/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers {{ gunicorn_workers }} \
    --timeout 60 \
    --access-logfile - \
    --error-logfile - \
    --capture-output

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rmit-api

Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
