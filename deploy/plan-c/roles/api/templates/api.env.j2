SECRET_KEY={{ django_secret_key }}

{# ------------------------------------------------------------------------
   [T15-BE-HOSTHDR] The variable that made Plan B tedious.

   The web tier proxies with `proxy_set_header Host $host`, so Django sees
   the *web* instance's public address, not its own. An ALLOWED_HOSTS
   containing only this instance's addresses would answer 400 to every
   proxied request -- and the error would look like a web-tier fault.

   Four entries, each for a different caller:
     web_public_ip    browsers, arriving through the web tier's proxy
     api_private_ip   the readiness check in this role, and any future
                      target group probing this instance directly
     127.0.0.1        the local nginx health probe
     localhost        manage.py and anything run by hand on the box

   None of them is typed by a human: the first comes from inventory, the
   second from IMDS.
--------------------------------------------------------------------------- #}
ALLOWED_HOSTS={{ web_public_ip }},{{ api_private_ip }},127.0.0.1,localhost

DATABASE_URL=postgres://{{ db_user }}:{{ db_password }}@{{ db_host }}:{{ db_port }}/{{ db_name }}

{# The origin a browser actually uses. Links in outgoing email must point at
   the web tier, never at the API instance, which is not publicly routable. #}
CLIENT_URL=http://{{ web_public_ip }}

{# The web tier proxies /api/ rather than the SPA calling this instance
   directly, so the browser only ever sees one origin and no cross-origin
   request is made. These are set to the web origin anyway: CSRF_TRUSTED_ORIGINS
   is consulted on any unsafe request that carries an Origin header, and
   leaving it wrong produces a 403 on login that mentions neither CSRF nor
   origins in a way anyone finds quickly.

   If the SPA is ever pointed straight at the API instance -- see
   web_api_mode in group_vars -- CORS starts mattering and this is already
   correct. #}
CORS_ALLOWED_ORIGINS=http://{{ web_public_ip }}
CSRF_TRUSTED_ORIGINS=http://{{ web_public_ip }}

{# prod.py defaults both to True. A secure cookie is never sent over
   http://, so the admin login accepts the password and bounces straight back
   to the login form with no error -- indistinguishable from a wrong password.
   Flip these to True the day TLS terminates in front of the web tier. #}
SESSION_COOKIE_SECURE={{ cookie_secure | ternary('True', 'False') }}
CSRF_COOKIE_SECURE={{ cookie_secure | ternary('True', 'False') }}

{# [ADV-3] Read from the checkout by the role, not supplied by hand, so
   /api/version/ cannot disagree with what is actually running. #}
APP_VERSION={{ app_version }}
GIT_COMMIT={{ api_deployed_commit }}
