# Source: deploy/plan-c/roles/api/templates/api-nginx.conf.j2

# The API instance's own web server: proxies Django
# paths to gunicorn and serves media and static off disk, which gunicorn
# cannot. Reachable only from the web tier's security group.

server {
    listen      80 default_server;
    listen [::]:80 default_server;
    server_name _;

    client_max_body_size 10M;

    location / {
        proxy_pass http://127.0.0.1:8000;

        # Forward the Host the web tier sent, not this
        # instance's address; Django builds image_url from it.
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect   off;

        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
    }

    # Uploaded product images, from this instance's disk. One replica only.
    location /media/ {
        alias {{ app_root }}/webapp/server/media/;
        access_log off;
        expires 7d;
    }

    # Django admin CSS, DRF's browsable API assets, Swagger UI.
    location /static/ {
        alias {{ app_root }}/webapp/server/staticfiles/;
        access_log off;
        expires 7d;
    }
}
