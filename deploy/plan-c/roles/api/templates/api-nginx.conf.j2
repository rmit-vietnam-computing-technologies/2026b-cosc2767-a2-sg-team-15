# MANAGED BY ANSIBLE -- edits here are overwritten on the next run.
# Source: deploy/plan-c/roles/api/templates/api-nginx.conf.j2

# The API instance's own web server.
#
# Two jobs, and the second is why this exists at all:
#
#   1. Proxy Django-shaped paths to gunicorn on 127.0.0.1:8000.
#   2. Serve uploaded media and collected static files off local disk.
#
# gunicorn can do neither of those file jobs. Django returns 404 for uploaded
# media under a production settings module by design, so if the web tier
# proxied /media/ straight to port 8000 it would proxy to a 404. Splitting
# the tiers is what turns that from a non-issue into a real one -- in Plan B
# a single nginx had the files locally.
#
# Reachable only from the web tier's security group. There is no public
# route to this port.

server {
    listen      80 default_server;
    listen [::]:80 default_server;
    server_name _;

    client_max_body_size 10M;

    location / {
        proxy_pass http://127.0.0.1:8000;

        # Forward the header the web tier sent, not this
        # instance's own address.
        #
        # $host here is whatever arrived from the web tier, which is the
        # public address a browser typed. Django builds image_url from it, so
        # replacing it with $proxy_host would produce URLs pointing at this
        # instance's private IP -- unreachable from any browser, and perfectly
        # working from a shell on either instance.
        #
        # Whatever ends up in $host must be in ALLOWED_HOSTS or Django
        # answers 400 before reaching a view.
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect   off;

        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
    }

    # Uploaded product images, from this instance's disk.
    #
    # This is the tier boundary that S3 removes. With media here, a second
    # API replica cannot serve images uploaded to the first, and the failure
    # is intermittent rather than total -- which is far worse to diagnose.
    location /media/ {
        alias {{ app_root }}/webapp/server/media/;
        access_log off;
        expires 7d;
    }

    # Django admin CSS, DRF's browsable API assets, Swagger UI.
    location /static/ {
        alias {{ app_root }}/webapp/server/staticfiles/;
        access_log off;
        expires 7d;
    }
}
