#   https://docs.docker.com/reference/compose-file/interpolation/

# Compose variables. TEMPLATE, placeholders only.  cp .env.example .env
# Not the same file as webapp/server/.env, which manage.py reads for a laptop run.

# Image tag: GIT_COMMIT=$(git rev-parse --short HEAD) docker compose up -d --build
GIT_COMMIT=dev
APP_VERSION=1.0.0

POSTGRES_DB=rmit_store
POSTGRES_USER=rmit
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET

# What a browser types: bare host, and the origin.
PUBLIC_HOST=localhost
PUBLIC_ORIGIN=http://localhost

# True only once TLS terminates in front of the web tier.
COOKIE_SECURE=False

# One gunicorn worker per api container; scale with replicas.
WEB_CONCURRENCY=1

WEB_PORT=80

# False: the shared media volume. True: the bucket, credentials from the instance role.
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Seed profile only.
SEED_ADMIN_EMAIL=admin@rmit.edu.au
SEED_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
