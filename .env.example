# Acknowledgement: Values derived from deploy/plan-c/group_vars/all.yml.example.
#   Reference: Compose environment variable interpolation,
#   https://docs.docker.com/reference/compose-file/interpolation/

# Compose variables -- TEMPLATE, placeholders only.
#
#     cp .env.example .env
#     $EDITOR .env
#
# .env is gitignored. This template exists so a marker can see every value
# the stack needs without any of the secrets.
#
# Read by `docker compose` to interpolate compose.yaml. It is NOT handed to
# any container wholesale: compose.yaml names each variable a service
# receives. This is a different file from server/.env, which manage.py reads
# for a laptop run outside containers and which the API image never sees.
#
# Values containing `$` must be written as `$$`, or Compose interpolates
# them. The key generator below cannot produce one.

# --- Image tags ------------------------------------------------------------

# Images are tagged with the commit they were built from, so /api/version/
# and `docker image ls` agree. Set from the shell to override:
#     GIT_COMMIT=$(git rev-parse --short HEAD) docker compose up -d --build
GIT_COMMIT=dev
APP_VERSION=1.0.0

# --- Database --------------------------------------------------------------

POSTGRES_DB=rmit_store
POSTGRES_USER=rmit
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

# --- Django ----------------------------------------------------------------

# Generate once, then keep it. Rotating invalidates every session and every
# outstanding password-reset link:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET

# What a browser types to reach the store, in two forms: the bare host for
# ALLOWED_HOSTS and the origin for CLIENT_URL and the CORS/CSRF lists.
# localhost on a laptop; the instance's public address when this file is
# used on one.
PUBLIC_HOST=localhost
PUBLIC_ORIGIN=http://localhost

# True only once TLS terminates in front of the web tier.
COOKIE_SECURE=False

# gunicorn workers. (2 x vCPU) + 1 is the usual starting point.
WEB_CONCURRENCY=3

# --- Web -------------------------------------------------------------------

# Host port that web publishes. The smoke suite expects http://localhost, so
# leave this at 80 unless something else already has it.
WEB_PORT=80

# --- Media storage ---------------------------------------------------------

# False: uploads live on the shared `media` volume, correct for one host.
# True: uploads go to the bucket, required the moment there are two hosts.
# Credentials are never listed here -- an instance role on EC2, or the
# session credentials via compose.s3.yaml for a laptop rehearsal.
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# --- Demo data -------------------------------------------------------------

# Only read by the seed profile. The demo member and merchant created
# alongside use the passwords documented in docs/TESTING.md.
SEED_ADMIN_EMAIL=admin@rmit.edu.au
SEED_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
