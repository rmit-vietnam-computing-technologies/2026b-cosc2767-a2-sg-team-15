# Acknowledgement: Reference: Compose environment variable interpolation,
#   https://docs.docker.com/reference/compose-file/interpolation/

# Compose variables -- TEMPLATE, placeholders only.  cp .env.example .env
#
# Read by `docker compose` to interpolate compose.yaml, which names each
# variable a service receives. Not the same file as webapp/server/.env,
# which manage.py reads for a laptop run. Write `$` as `$$`.

# --- Image tags: the commit the images were built from -----------------------
#     GIT_COMMIT=$(git rev-parse --short HEAD) docker compose up -d --build
GIT_COMMIT=dev
APP_VERSION=1.0.0

# --- Database ----------------------------------------------------------------
POSTGRES_DB=rmit_store
POSTGRES_USER=rmit
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

# --- Django ------------------------------------------------------------------
# Generate once and keep it; rotating invalidates every session:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET

# What a browser types: bare host for ALLOWED_HOSTS, origin for CORS/CSRF.
PUBLIC_HOST=localhost
PUBLIC_ORIGIN=http://localhost

# True only once TLS terminates in front of the web tier.
COOKIE_SECURE=False

# gunicorn workers; (2 x vCPU) + 1 is the usual start.
WEB_CONCURRENCY=3

# --- Web ---------------------------------------------------------------------
# The smoke suite expects http://localhost.
WEB_PORT=80

# --- Media storage -----------------------------------------------------------
# False: the shared `media` volume (one host). True: the bucket (two or more).
# No credentials here: an instance role on EC2, compose.s3.yaml on a laptop.
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# --- Demo data (seed profile only) -------------------------------------------
SEED_ADMIN_EMAIL=admin@rmit.edu.au
SEED_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
