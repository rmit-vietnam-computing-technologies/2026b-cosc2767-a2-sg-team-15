# ---------------------------------------------------------------------------
# [T15-BE-TEST] Line endings
#
# The team works across Windows and Linux. Git for Windows defaults to
# core.autocrlf=true, so a shell script authored on Windows can reach a
# container with CRLF endings and fail at run time with:
#
#     /entrypoint.sh: line 2: $'\r': command not found
#     exec /entrypoint.sh: no such file or directory
#
# The second one is the worst kind of bug in this assignment: the kernel is
# reporting that the interpreter "/bin/sh\r" does not exist, but the message
# names the script, so it reads as a missing file. Pinning eol here means the
# repository is the single source of truth and nobody's local git config can
# produce it.
#
# Deliberately NOT `* text=auto eol=lf`. Two upstream files
# (webapp/client/src/styles/main.scss and _variables.scss) are stored with CRLF, and a
# blanket rule would rewrite them — putting two vendored files into the
# modifications table in docs/UPSTREAM.md for no reason. Scoping to the
# extensions we author leaves the import byte-identical.
# ---------------------------------------------------------------------------

# --- Must be LF: anything a Linux host executes or parses ------------------
*.sh            text eol=lf
*.bash          text eol=lf
*.py            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.j2            text eol=lf
*.conf          text eol=lf
*.cfg           text eol=lf
*.ini           text eol=lf
*.service       text eol=lf
*.tf            text eol=lf
*.tfvars        text eol=lf
*.env           text eol=lf
*.env.*         text eol=lf
.env.*          text eol=lf
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
*.Dockerfile    text eol=lf
.dockerignore   text eol=lf
Makefile        text eol=lf
Jenkinsfile     text eol=lf
*.md            text eol=lf

# --- Must be CRLF: only ever run by Windows --------------------------------
*.ps1           text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# --- Binary: never touched, never diffed as text ---------------------------
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.webp          binary
*.pdf           binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.eot           binary
*.zip           binary
*.gz            binary
*.tar           binary
*.pem           binary

# --- Keep generated lockfiles out of PR diffs ------------------------------
package-lock.json   linguist-generated=true
